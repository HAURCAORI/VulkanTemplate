#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube envMap;
layout(set = 0, binding = 1, rgba16f) writeonly uniform image2DArray outIrradiance;

layout(push_constant) uniform Push {
    uint faceSize;
} push;

const float PI = 3.14159265359;

// Map cubemap face + pixel coord to a 3D direction vector.
// Vulkan cubemap face order and sc/tc axes (Vulkan spec Table 15.1):
//   +X: sc=-rz, tc=-ry   -X: sc=+rz, tc=-ry
//   +Y: sc=+rx, tc=+rz   -Y: sc=+rx, tc=-rz
//   +Z: sc=+rx, tc=-ry   -Z: sc=-rx, tc=-ry
vec3 faceDir(uint face, vec2 uv) { // uv in [-1,1]
    if (face == 0u) return normalize(vec3( 1.0, -uv.y, -uv.x));
    if (face == 1u) return normalize(vec3(-1.0, -uv.y,  uv.x));
    if (face == 2u) return normalize(vec3( uv.x,  1.0,  uv.y));
    if (face == 3u) return normalize(vec3( uv.x, -1.0, -uv.y));
    if (face == 4u) return normalize(vec3( uv.x, -uv.y,  1.0));
    return normalize(vec3(-uv.x, -uv.y, -1.0)); // face 5
}

void main() {
    uint  face  = gl_GlobalInvocationID.z;
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(push.faceSize) || coord.y >= int(push.faceSize)) return;

    vec2 uv     = (vec2(coord) + 0.5) / float(push.faceSize) * 2.0 - 1.0;
    vec3 normal = faceDir(face, uv);

    // Build TBN so we can sample the hemisphere aligned to this normal.
    vec3 up    = abs(normal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 right = normalize(cross(up, normal));
    up         = cross(normal, right);

    vec3  irradiance = vec3(0.0);
    float samples    = 0.0;
    float delta      = 0.04; // angular step in radians (~3840 samples over hemisphere)
    for (float phi = 0.0; phi < 2.0 * PI; phi += delta) {
        for (float theta = 0.0; theta < 0.5 * PI; theta += delta) {
            float st = sin(theta);
            float ct = cos(theta);
            vec3 tangentDir = vec3(st * cos(phi), st * sin(phi), ct);
            vec3 sampleDir  = tangentDir.x * right + tangentDir.y * up + tangentDir.z * normal;
            irradiance += texture(envMap, sampleDir).rgb * ct * st;
            samples    += 1.0;
        }
    }
    irradiance = PI * irradiance / samples;
    imageStore(outIrradiance, ivec3(coord, int(face)), vec4(irradiance, 1.0));
}
